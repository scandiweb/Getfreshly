// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  userId    String
  role      String   @default("user")
  chatType  String   @default("general") // "general" or "dashboard"
  isLoading Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, chatType])
}

model LinkedAccount {
  id          String      @id @default(cuid())
  userId      String
  accountType String
  accessToken String
  accountId   String
  accountName String
  adAccounts  AdAccount[]
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, accountId])
  @@index([userId, accountType])
}

model AdAccount {
  id                    String                 @id @default(cuid())
  userId                String
  linkedAccountId       String
  linkedAccount         LinkedAccount          @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accountId             String
  accountName           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([linkedAccountId])
}

model AdPerformanceSnapshot {
  id                    String                @id @default(cuid())
  userId                String
  facebookAdAccountId   String                // Facebook's actual ad account ID
  totalAdsAnalyzed      Int
  averageImpressions    Float
  averageCTR            Float
  // Cached metrics data
  totalSpend            Float   @default(0)
  totalImpressions      Int     @default(0)
  totalClicks           Int     @default(0)
  overallCTR            Float   @default(0)
  activeCampaigns       Int     @default(0)
  activeAdSets          Int     @default(0)
  activeAds             Int     @default(0)
  ads                   AdPerformanceData[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([userId, facebookAdAccountId])
  @@index([createdAt])
}

model AdPerformanceData {
  id                      String                @id @default(cuid())
  snapshotId              String
  snapshot                AdPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facebookAdId            String                // Facebook's ad ID
  adName                  String
  impressions             Int
  ctr                     Float
  engagementRateRanking   String?
  performanceScore        Int
  performanceCategory     String                // "best" or "worst"
  impressionsVsAverage    String                // "above", "below", "average"
  ctrVsAverage            String                // "above", "below", "average"
  engagementRanking       String                // "above", "below", "average", "unknown"
  reasons                 String[]              // JSON array of reasons
  previewUrl              String?               // Cached ad preview URL
  adCreatedTime           DateTime
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([snapshotId])
  @@index([facebookAdId])
}
